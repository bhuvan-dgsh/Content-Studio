rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'bhuvangowdan71@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      // Anyone authenticated or unauthenticated can view approved public listings
      // Sellers can view their own listings regardless of status (draft, pending_verification, admin_review, rejected)
      // Admins can view all listings
      allow read: if resource.data.status == 'approved' || (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
      
      // Sellers can create listings
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      
      // Sellers can update their own listings, Admins can update any listing (e.g. status changes, verification scores)
      allow update: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
      
      // Sellers can delete their own listings, Admins can delete any listing
      allow delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    match /inquiries/{inquiryId} {
      // Buyers can view their sent inquiries; Sellers can view inquiries for their listings; Admins can view all
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      
      // Authenticated buyers can create inquiries
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      
      // Seller or buyer can update inquiry status
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
    }
  }
}

